{
  "name": "prompt-to-api",
  "version": "0.1.0",
  "description": "OpenAI-compatible REST gateway for local single-prompt / print-mode AI CLIs",
  "type": "module",
  "license": "MIT",
  "bin": {
    "prompt-to-api": "./bin/prompt-to-api.mjs"
  },
  "files": [
    "bin",
    "src",
    "config",
    "README.md",
    "LICENSE",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run typecheck",
    "prepublishOnly": "bun run typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.12.33",
    "smol-toml": "^1.7.1",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "author": "Tariq West",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariqwest/prompt-to-api.git"
  },
  "bugs": {
    "url": "https://github.com/tariqwest/prompt-to-api/issues"
  },
  "homepage": "https://github.com/tariqwest/prompt-to-api#readme",
  "keywords": [
    "openai",
    "openai-compatible",
    "gateway",
    "hono",
    "prompt",
    "cli",
    "coding-agent",
    "rest",
    "llm"
  ],
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
