{
  "host": "127.0.0.1",
  "port": 8788,
  "authToken": null,
  "defaultCwd": "~/.config/prompt-to-api/cwd",
  "trusted": true,
  "timeoutMs": 600000,
  "concurrency": {
    "maxGlobal": 8,
    "maxPerAgent": 2
  },
  "session": {
    "enabled": true,
    "ttlMs": 3600000,
    "maxSessions": 256,
    "maxTurns": 40,
    "maxChars": 200000,
    "persistDir": "~/.cache/prompt-to-api/sessions",
    "flushIntervalMs": 1000
  }
}
